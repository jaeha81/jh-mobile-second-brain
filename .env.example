# GitHub Personal Access Token (Fine-grained 권장)
# 절대 NEXT_PUBLIC_ 붙이지 말 것 — 서버 전용
GITHUB_TOKEN=

# GitHub 계정명
GITHUB_OWNER=

# private repo 이름
GITHUB_REPO=

# 브랜치 (기본값: main)
GITHUB_BRANCH=main

# Vault 루트 경로 (기본값: obsidian-vault)
GITHUB_BASE_PATH=obsidian-vault

# 앱 표시명 (클라이언트 공개 가능)
NEXT_PUBLIC_APP_NAME=Mobile Second Brain Capture
