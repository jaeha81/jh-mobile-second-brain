# Google Service Account JSON (한 줄로 직렬화된 JSON 문자열)
# Google Cloud Console → IAM → 서비스 계정 → 키 생성 → JSON
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive 폴더 ID (Obsidian Second 루트 폴더)
# 폴더 URL: https://drive.google.com/drive/folders/{이 부분}
GOOGLE_DRIVE_FOLDER_ID=

# 앱 표시명 (클라이언트 공개 가능)
NEXT_PUBLIC_APP_NAME=Mobile Second Brain Capture

# 내부 API 인증 시크릿 (선택사항 — 설정 시 upload-audio에 헤더 인증 적용)
INTERNAL_API_SECRET=
